<Window
    x:Class="AngesnHardwareWidget.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:AngesnHardwareWidget.ViewModels"
    Title="Hardware Monitoring"
    Width="620"
    Height="760"
    MinWidth="580"
    MinHeight="420"
    Background="#FFF7F8FA"
    FontFamily="Segoe UI Variable Text"
    Foreground="#FF20252B"
    Icon="/AngesnHardwareWidget;component/Assets/AngesnHardwareWidget.ico"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen">

    <!--
        A plain Window, not a MetroWindow: the application theme is MahApps Dark.Teal, which the
        widget uses, and a MetroWindow here would inherit that dark surface. The AI Usage Monitor's
        Settings window solves it the same way, with an explicit light palette.
    -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AngesnHardwareWidget;component/Views/LightDialogTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <Style x:Key="RowLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,12,0" />
            </Style>
            <Style
                x:Key="RowCombo"
                BasedOn="{StaticResource {x:Type ComboBox}}"
                TargetType="ComboBox">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Width" Value="170" />
                <Setter Property="Margin" Value="0,3" />
            </Style>
            <!--
                No DisplayMemberPath: the ComboBox template formats items via ToString(), which
                PollingIntervalOption overrides.
            -->
            <Style
                x:Key="IntervalCombo"
                BasedOn="{StaticResource RowCombo}"
                TargetType="ComboBox" />
            <Style
                x:Key="RowNumberBox"
                BasedOn="{StaticResource {x:Type TextBox}}"
                TargetType="TextBox">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
                <Setter Property="Width" Value="60" />
                <Setter Property="Margin" Value="0,3" />
            </Style>
            <!--
                Narrower: used where three label/box pairs share one row, so the boxes stay small
                enough for labels and boxes to line up as real grid columns rather than crowding
                each other out.
            -->
            <Style
                x:Key="CompactNumberBox"
                BasedOn="{StaticResource RowNumberBox}"
                TargetType="TextBox">
                <Setter Property="Width" Value="42" />
            </Style>
            <Style x:Key="SectionHeading" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style x:Key="HintText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource DialogMutedTextBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style
                x:Key="StageBox"
                BasedOn="{StaticResource {x:Type TextBox}}"
                TargetType="TextBox">
                <Setter Property="Width" Value="54" />
                <Setter Property="Margin" Value="3,0" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="StageHeader" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource DialogMutedTextBrush}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Width" Value="54" />
                <Setter Property="Margin" Value="3,0" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="0"
            Padding="0,0,10,0"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--  ======================= General: applies immediately ====================  -->
                <TextBlock Style="{StaticResource SectionHeading}" Text="General" />

                <CheckBox
                    Margin="0,4,0,0"
                    Content="Start with Windows"
                    IsChecked="{Binding StartWithWindows}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{StaticResource HintText}"
                    Text="Automatically start the widget when you sign in, about 10 seconds after logon. This registers a scheduled task with administrator rights, so later sign-ins start the widget without a UAC prompt. It does not affect Defender or the driver blocking, so it will not restore CPU temperature on its own." />

                <Separator Margin="0,16,0,12" />

                <!--  ==================== Appearance: applies immediately ===================  -->
                <TextBlock Style="{StaticResource SectionHeading}" Text="Appearance" />
                <TextBlock
                    Margin="0,0,0,8"
                    Style="{StaticResource HintText}"
                    Text="Applies immediately — no need to save." />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource RowLabel}"
                        Text="Widget appearance" />
                    <ComboBox
                        Grid.Row="0"
                        Grid.Column="1"
                        ItemsSource="{Binding WidgetAppearances}"
                        SelectedItem="{Binding WidgetAppearance}"
                        Style="{StaticResource RowCombo}" />

                    <!--
                        Font and text weight share a row: neither needs the full dialog width, and
                        they are the same kind of choice (how the widget's text looks), so pairing
                        them keeps this section from running one row longer than it needs to.
                    -->
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource RowLabel}"
                        Text="Font" />
                    <ComboBox
                        Grid.Row="1"
                        Grid.Column="1"
                        ItemsSource="{Binding WidgetFonts}"
                        SelectedItem="{Binding WidgetFont}"
                        Style="{StaticResource RowCombo}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="16,0,8,0"
                        Style="{StaticResource RowLabel}"
                        Text="Text weight" />
                    <ComboBox
                        Grid.Row="1"
                        Grid.Column="3"
                        ItemsSource="{Binding WidgetTextWeights}"
                        SelectedItem="{Binding WidgetTextWeight}"
                        Style="{StaticResource RowCombo}" />
                </Grid>

                <!--
                    Three separate Grids (one per field group), each followed by its own plain
                    HintText outside the Grid, rather than one Grid holding all three groups plus
                    their explanations. A TextBlock spanning several Auto columns forces WPF to
                    measure it at its full, unwrapped width to decide how wide those columns need
                    to be, so a whole paragraph living inside the Grid ballooned every column out to
                    fit one line of text, pushing "Value width" and "Min width (RAM)" off the right
                    edge of the dialog entirely. Kept outside the Grid, each hint is free to wrap
                    against the StackPanel's real width instead.
                -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        Style="{StaticResource RowLabel}"
                        Text="Label width" />
                    <TextBox
                        Grid.Column="1"
                        Style="{StaticResource CompactNumberBox}"
                        Text="{Binding WidgetLabelColumnWidthText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Column="3"
                        Margin="0,0,8,0"
                        Style="{StaticResource RowLabel}"
                        Text="Graph width" />
                    <TextBox
                        Grid.Column="4"
                        Style="{StaticResource CompactNumberBox}"
                        Text="{Binding WidgetGraphColumnWidthText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Column="6"
                        Margin="0,0,8,0"
                        Style="{StaticResource RowLabel}"
                        Text="Value width" />
                    <TextBox
                        Grid.Column="7"
                        Style="{StaticResource CompactNumberBox}"
                        Text="{Binding WidgetValueColumnWidthText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <TextBlock
                    Margin="0,4,0,0"
                    Style="{StaticResource HintText}"
                    Text="These three are pixel sizes for the label, graph and value columns of every row. Enter * instead of a number to let that column take up whatever the other two leave unused -- Value width does this by default." />

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        Style="{StaticResource RowLabel}"
                        Text="Graph min height" />
                    <TextBox
                        Grid.Column="1"
                        Style="{StaticResource CompactNumberBox}"
                        Text="{Binding WidgetGraphHeightMinimumText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Column="3"
                        Margin="0,0,8,0"
                        Style="{StaticResource RowLabel}"
                        Text="Graph max height" />
                    <TextBox
                        Grid.Column="4"
                        Style="{StaticResource CompactNumberBox}"
                        Text="{Binding WidgetGraphHeightMaximumText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <TextBlock
                    Margin="0,4,0,0"
                    Style="{StaticResource HintText}"
                    Text="The graph has no fixed height of its own: it stretches to fill its row, and these two just bound how far it can stretch." />

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        Style="{StaticResource RowLabel}"
                        Text="Min column width" />
                    <TextBox
                        Grid.Column="1"
                        Style="{StaticResource CompactNumberBox}"
                        Text="{Binding WidgetMinimumColumnWidthText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Column="3"
                        Margin="0,0,8,0"
                        Style="{StaticResource RowLabel}"
                        Text="Min width (RAM)" />
                    <TextBox
                        Grid.Column="4"
                        Style="{StaticResource CompactNumberBox}"
                        Text="{Binding WidgetMinimumColumnWidthWithRamText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!--
                    Unrelated to the three column widths above, which is exactly why it was easy to
                    misread as one of them: this is not a width on a row, it is the narrowest one
                    whole column of rows may get before the widget folds multiple columns back into
                    one. "Min width (RAM)" is the same threshold, used instead while RAM used/total
                    is shown, since that wider text needs more room before another column is worth it.
                -->
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{StaticResource HintText}"
                    Text="Min column width / Min width (RAM): when the widget is wide enough to lay its metrics out in more than one side-by-side column, this is how narrow each of those columns may get before it folds back down to fewer." />

                <CheckBox
                    Margin="0,10,0,0"
                    Content="Show RAM used / total GB"
                    IsChecked="{Binding ShowRamUsedAndTotal}" />

                <!--
                    "23.2/63.9 GB (36%)" needs a wider value column than every other metric ever
                    does, so this only appears, and only applies, while RAM digits are on.
                -->
                <StackPanel
                    Margin="0,6,0,0"
                    Orientation="Horizontal"
                    Visibility="{Binding ShowRamUsedAndTotal, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Style="{StaticResource RowLabel}" Text="Value width (RAM shown)" />
                    <TextBox Style="{StaticResource RowNumberBox}" Text="{Binding WidgetValueColumnWidthWithRamText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>


                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource HintText}"
                    Text="Text size, opacity, always-on-top and lock are on the widget's right-click menu." />

                <Separator Margin="0,16,0,12" />

                <!--  ================== Colour stages & display: applies immediately ==================  -->
                <TextBlock Style="{StaticResource SectionHeading}" Text="Colour stages &amp; display" />
                <TextBlock
                    Margin="0,0,0,6"
                    Style="{StaticResource HintText}"
                    Text="Applies immediately. Untick Show to hide a metric from the widget entirely, or untick Graph to keep its label and value but drop just the history sparkline. Drag the grip to reorder — the widget follows this order. Each metric is graded over its own scale rather than 0–100, because a CPU is never near 0 °C and fan RPM is not a percentage. Enter the upper bound of stages 1 to 4; stage 5 is everything above stage 4." />

                <StackPanel Margin="0,4,0,10" Orientation="Horizontal">
                    <Border
                        Width="20"
                        Height="12"
                        Margin="0,0,4,0"
                        Background="#2ECC71"
                        CornerRadius="2" />
                    <Border
                        Width="20"
                        Height="12"
                        Margin="0,0,4,0"
                        Background="#9ACD32"
                        CornerRadius="2" />
                    <Border
                        Width="20"
                        Height="12"
                        Margin="0,0,4,0"
                        Background="#FFD21E"
                        CornerRadius="2" />
                    <Border
                        Width="20"
                        Height="12"
                        Margin="0,0,4,0"
                        Background="#FF9800"
                        CornerRadius="2" />
                    <Border
                        Width="20"
                        Height="12"
                        Margin="0,0,8,0"
                        Background="#FF4D4F"
                        CornerRadius="2" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource HintText}"
                        Text="stage 1 (healthy) to stage 5 (critical)" />
                </StackPanel>

                <!--
                    Mirrors the row template's own column layout exactly (grip, show, graph, metric,
                    stages, scale) rather than eyeballed margins over a single column: each header
                    row is its own Grid, so Auto columns cannot align across rows on their own, and
                    the fixed MinWidths below are shared with the matching row columns further
                    down so a checkbox never has less room than its header.
                -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="22" />
                        <ColumnDefinition Width="Auto" MinWidth="26" />
                        <ColumnDefinition Width="Auto" MinWidth="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="1"
                        Width="Auto"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource StageHeader}"
                        Text="Show"
                        TextAlignment="Left" />
                    <TextBlock
                        Grid.Column="2"
                        Width="Auto"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource StageHeader}"
                        Text="Graph"
                        TextAlignment="Left" />
                    <TextBlock
                        Grid.Column="3"
                        Width="Auto"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource StageHeader}"
                        Text="Metric"
                        TextAlignment="Left" />
                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource StageHeader}" Text="1 ≤" />
                        <TextBlock Style="{StaticResource StageHeader}" Text="2 ≤" />
                        <TextBlock Style="{StaticResource StageHeader}" Text="3 ≤" />
                        <TextBlock Style="{StaticResource StageHeader}" Text="4 ≤" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="5"
                        Width="92"
                        Margin="8,0,0,0"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource StageHeader}"
                        Text="Scale"
                        TextAlignment="Left" />
                </Grid>

                <!--
                    A ListBox rather than an ItemsControl so each row has a container to
                    hit-test during a drag. Dragging starts only from the grip, so it cannot
                    interfere with the checkbox or with typing in the threshold boxes.
                -->
                <ListBox
                    HorizontalContentAlignment="Stretch"
                    AllowDrop="True"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding StageRows}"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="2,1" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="AllowDrop" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border
                                            Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="3">
                                            <ContentPresenter HorizontalAlignment="Stretch" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <EventSetter Event="DragOver" Handler="OnRowDragOver" />
                            <EventSetter Event="Drop" Handler="OnRowDrop" />
                            <Style.Triggers>
                                <!--
                                    Makes the drag grip discoverable and gives the live reorder
                                    something to follow.
                                -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFEDF1F5" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MetricStageRowViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="22" />
                                    <ColumnDefinition Width="Auto" MinWidth="26" />
                                    <ColumnDefinition Width="Auto" MinWidth="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Cursor="SizeAll"
                                    FontSize="13"
                                    Foreground="{StaticResource DialogMutedTextBrush}"
                                    PreviewMouseLeftButtonDown="OnDragGripPressed"
                                    Text="⋮⋮"
                                    ToolTip="Drag to reorder — this is the order the widget shows" />

                                <CheckBox
                                    Grid.Column="1"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding IsVisible}"
                                    ToolTip="Show this metric in the widget" />

                                <CheckBox
                                    Grid.Column="2"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding IsGraphVisible}"
                                    ToolTip="Show this metric's history graph" />

                                <TextBlock
                                    Grid.Column="3"
                                    Style="{StaticResource RowLabel}"
                                    Text="{Binding Label}" />

                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                    <TextBox Style="{StaticResource StageBox}" Text="{Binding Stage1Maximum, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Style="{StaticResource StageBox}" Text="{Binding Stage2Maximum, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Style="{StaticResource StageBox}" Text="{Binding Stage3Maximum, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Style="{StaticResource StageBox}" Text="{Binding Stage4Maximum, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="5"
                                    Width="92"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource HintText}"
                                    Text="{Binding ScaleText}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    Command="{Binding ResetStagesCommand}"
                    Content="Reset stages to defaults" />

                <Separator Margin="0,16,0,12" />

                <!--  =========== Monitoring: pending until its own Save button below =========  -->
                <TextBlock Style="{StaticResource SectionHeading}" Text="Monitoring" />
                <TextBlock
                    Margin="0,0,0,10"
                    Style="{StaticResource HintText}"
                    Text="These rebuild the polling schedule, so they take effect when you press Save." />

                <CheckBox
                    Margin="0,0,0,12"
                    Content="Use same polling interval for all"
                    IsChecked="{Binding UseUnifiedPollingInterval}" />

                <Grid Visibility="{Binding UseUnifiedPollingInterval, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Style="{StaticResource RowLabel}"
                        Text="Polling interval" />
                    <ComboBox
                        Grid.Column="1"
                        ItemsSource="{Binding IntervalOptions}"
                        SelectedItem="{Binding UnifiedInterval}"
                        Style="{StaticResource IntervalCombo}" />
                </Grid>

                <!--
                    Hidden entirely while unified polling is on, so there is no ambiguity about
                    which values are in effect.
                -->
                <Grid Visibility="{Binding IndividualIntervalsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource RowLabel}"
                        Text="CPU temperature" />
                    <ComboBox
                        Grid.Row="0"
                        Grid.Column="1"
                        ItemsSource="{Binding IntervalOptions}"
                        SelectedItem="{Binding CpuTemperatureInterval}"
                        Style="{StaticResource IntervalCombo}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource RowLabel}"
                        Text="CPU usage" />
                    <ComboBox
                        Grid.Row="1"
                        Grid.Column="1"
                        ItemsSource="{Binding IntervalOptions}"
                        SelectedItem="{Binding CpuUsageInterval}"
                        Style="{StaticResource IntervalCombo}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource RowLabel}"
                        Text="RAM usage" />
                    <ComboBox
                        Grid.Row="2"
                        Grid.Column="1"
                        ItemsSource="{Binding IntervalOptions}"
                        SelectedItem="{Binding MemoryUsageInterval}"
                        Style="{StaticResource IntervalCombo}" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Style="{StaticResource RowLabel}"
                        Text="GPU temperature" />
                    <ComboBox
                        Grid.Row="3"
                        Grid.Column="1"
                        ItemsSource="{Binding IntervalOptions}"
                        SelectedItem="{Binding GpuTemperatureInterval}"
                        Style="{StaticResource IntervalCombo}" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Style="{StaticResource RowLabel}"
                        Text="GPU core usage" />
                    <ComboBox
                        Grid.Row="4"
                        Grid.Column="1"
                        ItemsSource="{Binding IntervalOptions}"
                        SelectedItem="{Binding GpuComputeUsageInterval}"
                        Style="{StaticResource IntervalCombo}" />

                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        Style="{StaticResource RowLabel}"
                        Text="GPU memory usage" />
                    <ComboBox
                        Grid.Row="5"
                        Grid.Column="1"
                        ItemsSource="{Binding IntervalOptions}"
                        SelectedItem="{Binding GpuMemoryUsageInterval}"
                        Style="{StaticResource IntervalCombo}" />

                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        Style="{StaticResource RowLabel}"
                        Text="VRAM temperature" />
                    <ComboBox
                        Grid.Row="6"
                        Grid.Column="1"
                        ItemsSource="{Binding IntervalOptions}"
                        SelectedItem="{Binding GpuMemoryTemperatureInterval}"
                        Style="{StaticResource IntervalCombo}" />

                    <TextBlock
                        Grid.Row="7"
                        Grid.Column="0"
                        Style="{StaticResource RowLabel}"
                        Text="GPU fan" />
                    <ComboBox
                        Grid.Row="7"
                        Grid.Column="1"
                        ItemsSource="{Binding IntervalOptions}"
                        SelectedItem="{Binding GpuFanInterval}"
                        Style="{StaticResource IntervalCombo}" />
                </Grid>

                <Separator Margin="0,14,0,12" />

                <CheckBox
                    Margin="0,0,0,8"
                    Content="Poll more slowly when the computer is idle"
                    IsChecked="{Binding UseIdlePolling}" />

                <Grid Visibility="{Binding UseIdlePolling, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Style="{StaticResource RowLabel}"
                        Text="Consider idle after" />
                    <ComboBox
                        Grid.Column="1"
                        ItemsSource="{Binding IdleAfterOptions}"
                        SelectedItem="{Binding IdleAfter}"
                        Style="{StaticResource IntervalCombo}" />
                </Grid>

                <!--
                    Idle follows the same unified/individual mode as active polling, so exactly one
                    of these two blocks is ever visible.
                -->
                <Grid Visibility="{Binding IdleUnifiedVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Style="{StaticResource RowLabel}"
                        Text="Idle polling interval" />
                    <ComboBox
                        Grid.Column="1"
                        ItemsSource="{Binding IdleIntervalOptions}"
                        SelectedItem="{Binding IdleUnifiedInterval}"
                        Style="{StaticResource IntervalCombo}" />
                </Grid>

                <StackPanel Visibility="{Binding IdleIndividualVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock
                        Margin="0,6,0,4"
                        Style="{StaticResource HintText}"
                        Text="Idle interval per metric" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource RowLabel}"
                            Text="CPU temperature" />
                        <ComboBox
                            Grid.Row="0"
                            Grid.Column="1"
                            ItemsSource="{Binding IdleIntervalOptions}"
                            SelectedItem="{Binding IdleCpuTemperatureInterval}"
                            Style="{StaticResource IntervalCombo}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource RowLabel}"
                            Text="CPU usage" />
                        <ComboBox
                            Grid.Row="1"
                            Grid.Column="1"
                            ItemsSource="{Binding IdleIntervalOptions}"
                            SelectedItem="{Binding IdleCpuUsageInterval}"
                            Style="{StaticResource IntervalCombo}" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource RowLabel}"
                            Text="RAM usage" />
                        <ComboBox
                            Grid.Row="2"
                            Grid.Column="1"
                            ItemsSource="{Binding IdleIntervalOptions}"
                            SelectedItem="{Binding IdleMemoryUsageInterval}"
                            Style="{StaticResource IntervalCombo}" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Style="{StaticResource RowLabel}"
                            Text="GPU temperature" />
                        <ComboBox
                            Grid.Row="3"
                            Grid.Column="1"
                            ItemsSource="{Binding IdleIntervalOptions}"
                            SelectedItem="{Binding IdleGpuTemperatureInterval}"
                            Style="{StaticResource IntervalCombo}" />

                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="0"
                            Style="{StaticResource RowLabel}"
                            Text="GPU core usage" />
                        <ComboBox
                            Grid.Row="4"
                            Grid.Column="1"
                            ItemsSource="{Binding IdleIntervalOptions}"
                            SelectedItem="{Binding IdleGpuComputeUsageInterval}"
                            Style="{StaticResource IntervalCombo}" />

                        <TextBlock
                            Grid.Row="5"
                            Grid.Column="0"
                            Style="{StaticResource RowLabel}"
                            Text="GPU memory usage" />
                        <ComboBox
                            Grid.Row="5"
                            Grid.Column="1"
                            ItemsSource="{Binding IdleIntervalOptions}"
                            SelectedItem="{Binding IdleGpuMemoryUsageInterval}"
                            Style="{StaticResource IntervalCombo}" />

                        <TextBlock
                            Grid.Row="6"
                            Grid.Column="0"
                            Style="{StaticResource RowLabel}"
                            Text="VRAM temperature" />
                        <ComboBox
                            Grid.Row="6"
                            Grid.Column="1"
                            ItemsSource="{Binding IdleIntervalOptions}"
                            SelectedItem="{Binding IdleGpuMemoryTemperatureInterval}"
                            Style="{StaticResource IntervalCombo}" />

                        <TextBlock
                            Grid.Row="7"
                            Grid.Column="0"
                            Style="{StaticResource RowLabel}"
                            Text="GPU fan" />
                        <ComboBox
                            Grid.Row="7"
                            Grid.Column="1"
                            ItemsSource="{Binding IdleIntervalOptions}"
                            SelectedItem="{Binding IdleGpuFanInterval}"
                            Style="{StaticResource IntervalCombo}" />
                    </Grid>
                </StackPanel>

                <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                    <Button
                        MinWidth="184"
                        Command="{Binding SaveMonitoringCommand}"
                        Content="Save monitoring settings"
                        Style="{StaticResource DialogPrimaryButton}" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource HintText}" TargetType="TextBlock">
                                <Setter Property="Text" Value="Unsaved changes" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnsavedMonitoringChanges}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <TextBlock
                Margin="0,0,0,6"
                Foreground="{StaticResource DialogErrorBrush}"
                Text="{Binding ValidationMessage}"
                TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ValidationMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource DialogSuccessBrush}"
                    Text="{Binding SavedMessage}" />

                <Button
                    Grid.Column="1"
                    MinWidth="88"
                    Command="{Binding CloseCommand}"
                    Content="Close"
                    IsCancel="True" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
