<Window
    x:Class="AngesnHardwareWidget.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AngesnHardwareWidget.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:vm="clr-namespace:AngesnHardwareWidget.ViewModels"
    Title="Angesn Hardware Widget"
    MinWidth="130"
    MinHeight="70"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowDesignViewModel,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="164"
    d:DesignWidth="880"
    AllowsTransparency="True"
    Background="#01000000"
    Icon="/AngesnHardwareWidget;component/Assets/AngesnHardwareWidget.ico"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    SizeToContent="Manual"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None"
    mc:Ignorable="d">

    <!--
        Runtime appearance settings replace these values. Keeping defaults in XAML lets Visual
        Studio render the complete widget even when it does not execute code-behind resources.
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <FontFamily x:Key="WidgetFontFamily">Segoe UI Variable Text</FontFamily>
        <FontFamily x:Key="WidgetValueFontFamily">Segoe UI Variable Text</FontFamily>
        <FontWeight x:Key="WidgetValueFontWeight">Bold</FontWeight>
        <system:Double x:Key="WidgetLabelFontSize">11</system:Double>
        <system:Double x:Key="WidgetValueFontSize">14</system:Double>
        <system:Double x:Key="WidgetMinimumColumnWidth">190</system:Double>
        <GridLength x:Key="WidgetLabelColumnWidth">78</GridLength>
        <GridLength x:Key="WidgetGraphColumnWidth">58</GridLength>
        <GridLength x:Key="WidgetValueColumnWidth">*</GridLength>
        <system:Double x:Key="WidgetGraphHeightMinimum">1</system:Double>
        <system:Double x:Key="WidgetGraphHeightMaximum">200</system:Double>
        <SolidColorBrush x:Key="WidgetCardBackground" Color="#E62A2F38" />
        <SolidColorBrush x:Key="WidgetCardBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="WidgetLabelBrush" Color="#E6EBF0" />
        <Thickness x:Key="WidgetCardBorderThickness">0</Thickness>
        <CornerRadius x:Key="WidgetCardCornerRadius">10</CornerRadius>
    </Window.Resources>

    <!--
        Background is #01000000 (alpha 1/255) rather than Transparent, the same trick the AI Usage
        Monitor's taskbar widget uses: this is a layered window, and Windows routes mouse input
        *through* pixels whose alpha is zero, so a fully transparent margin would hand drags and
        right-clicks to whatever sits underneath. Alpha 1 is visually indistinguishable but
        hit-testable.
    -->

    <Border
        Background="{DynamicResource WidgetCardBackground}"
        BorderBrush="{DynamicResource WidgetCardBorderBrush}"
        BorderThickness="{DynamicResource WidgetCardBorderThickness}"
        CornerRadius="{DynamicResource WidgetCardCornerRadius}"
        SnapsToDevicePixels="True">

        <!--
            Same shape as the AI Usage Monitor's widget menu, including its rule that Exit lives only
            on the tray icon: it must not sit where someone aiming to dismiss the widget can hit it.
        -->
        <Border.ContextMenu>
            <ContextMenu Opened="OnContextMenuOpened">
                <MenuItem Command="{Binding RefreshCommand}" Header="Refresh" />
                <MenuItem Command="{Binding OpenSettingsCommand}" Header="Settings" />
                <Separator />
                <MenuItem x:Name="PollingIntervalMenuItem" Header="Polling interval" />
                <MenuItem x:Name="TextSizeMenuItem" Header="Text size">
                    <MenuItem
                        Click="OnTextScaleClick"
                        Header="Small"
                        IsCheckable="True"
                        Tag="0.85" />
                    <MenuItem
                        Click="OnTextScaleClick"
                        Header="Normal"
                        IsCheckable="True"
                        Tag="1.0" />
                    <MenuItem
                        Click="OnTextScaleClick"
                        Header="Large"
                        IsCheckable="True"
                        Tag="1.15" />
                    <MenuItem
                        Click="OnTextScaleClick"
                        Header="Larger"
                        IsCheckable="True"
                        Tag="1.3" />
                    <MenuItem
                        Click="OnTextScaleClick"
                        Header="Largest"
                        IsCheckable="True"
                        Tag="1.5" />
                </MenuItem>
                <MenuItem x:Name="OpacityMenuItem" Header="Opacity">
                    <MenuItem
                        Click="OnOpacityClick"
                        Header="100%"
                        IsCheckable="True"
                        Tag="1.0" />
                    <MenuItem
                        Click="OnOpacityClick"
                        Header="90%"
                        IsCheckable="True"
                        Tag="0.9" />
                    <MenuItem
                        Click="OnOpacityClick"
                        Header="80%"
                        IsCheckable="True"
                        Tag="0.8" />
                    <MenuItem
                        Click="OnOpacityClick"
                        Header="70%"
                        IsCheckable="True"
                        Tag="0.7" />
                    <MenuItem
                        Click="OnOpacityClick"
                        Header="60%"
                        IsCheckable="True"
                        Tag="0.6" />
                </MenuItem>
                <Separator />
                <MenuItem
                    x:Name="AlwaysOnTopMenuItem"
                    Click="OnAlwaysOnTopClick"
                    Header="Always on Top"
                    IsCheckable="True" />
                <MenuItem
                    x:Name="LockWidgetMenuItem"
                    Click="OnLockClick"
                    Header="Lock Position"
                    IsCheckable="True" />
                <Separator />
                <MenuItem Click="OnHideClick" Header="Hide Widget" />
            </ContextMenu>
        </Border.ContextMenu>

        <!--
            Margin leaves the 7px edge band that WM_NCHITTEST claims for resizing, so grabbing an
            edge resizes instead of landing on a metric row. Nothing else is in here: no title and
            no gear, so the card is only the readout. Settings is on the right-click menu and the
            tray icon.
        -->
        <ItemsControl
            Margin="10,8,10,8"
            Focusable="False"
            ItemsSource="{Binding Metrics}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:MetricColumnsPanel ColumnSpacing="16" MinimumColumnWidth="{DynamicResource WidgetMinimumColumnWidth}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:MetricTileViewModel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!--
                                A fixed label column, not Auto: Auto sizes every row to its own
                                text, so the graphs and values stepped left and right down the
                                card. A shared width lines all three columns up.
                            -->
                            <ColumnDefinition Width="{DynamicResource WidgetLabelColumnWidth}" />
                            <ColumnDefinition Width="{DynamicResource WidgetGraphColumnWidth}" />
                            <!--
                                Bound to this row's own tile rather than a shared resource: the RAM
                                override only widens the RAM row, and every other row keeps
                                WidgetValueColumnWidth's normal size (see MainViewModel).
                            -->
                            <ColumnDefinition Width="{Binding ValueColumnWidth}" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource WidgetFontFamily}"
                            FontSize="{DynamicResource WidgetLabelFontSize}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource WidgetLabelBrush}"
                            Opacity="0.7"
                            Text="{Binding Label}"
                            TextTrimming="CharacterEllipsis" />

                        <controls:MetricHistoryGraph
                            Grid.Column="1"
                            MinHeight="{DynamicResource WidgetGraphHeightMinimum}"
                            MaxHeight="{DynamicResource WidgetGraphHeightMaximum}"
                            Margin="0,1,0,1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            ItemsSource="{Binding History}"
                            LineBrush="{Binding ValueBrush}"
                            Maximum="{Binding GraphMaximum}"
                            ToolTip="Last 15 minutes"
                            Visibility="{Binding ShowGraph, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <TextBlock
                            Grid.Column="2"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource WidgetValueFontFamily}"
                            FontSize="{DynamicResource WidgetValueFontSize}"
                            FontWeight="{DynamicResource WidgetValueFontWeight}"
                            Foreground="{Binding ValueBrush}"
                            Text="{Binding Display}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
