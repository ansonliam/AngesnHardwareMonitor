<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AngesnHardwareWidget</AssemblyName>
    <RootNamespace>AngesnHardwareWidget</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AngesnHardwareWidget.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.1.0-mvp</Version>
  </PropertyGroup>

  <!-- UseWindowsForms is only here for the tray NotifyIcon. Its implicit usings would drop
       System.Windows.Forms and System.Drawing into every file, making Brush, Color, Size, Panel and
       Application ambiguous against their WPF counterparts, so they are removed and the tray
       service aliases what it needs instead. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AngesnHardwareWidget.ico" />
    <Resource Include="Assets\fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

</Project>
