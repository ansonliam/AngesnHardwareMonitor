<Window x:Class="HardwareWidget.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HardwareWidget.ViewModels"
        Title="Hardware Monitoring"
        Width="620"
        Height="760"
        MinWidth="580"
        MinHeight="420"
        Background="#FFF7F8FA"
        Foreground="#FF20252B"
        FontFamily="Segoe UI Variable Text"
        Icon="/HardwareWidget;component/Assets/HardwareWidget.ico"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <!-- A plain Window, not a MetroWindow: the application theme is MahApps Dark.Teal, which the
         widget uses, and a MetroWindow here would inherit that dark surface. The AI Usage Monitor's
         Settings window solves it the same way, with an explicit light palette. -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HardwareWidget;component/Views/LightDialogTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <Style x:Key="RowLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,12,0" />
            </Style>
            <Style x:Key="RowCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Width" Value="170" />
                <Setter Property="Margin" Value="0,3" />
            </Style>
            <!-- No DisplayMemberPath: the ComboBox template formats items via ToString(), which
                 PollingIntervalOption overrides. -->
            <Style x:Key="IntervalCombo" TargetType="ComboBox" BasedOn="{StaticResource RowCombo}" />
            <Style x:Key="SectionHeading" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource DialogTextBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style x:Key="HintText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource DialogMutedTextBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="StageBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Width" Value="54" />
                <Setter Property="Margin" Value="3,0" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="StageHeader" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource DialogMutedTextBrush}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Width" Value="54" />
                <Setter Property="Margin" Value="3,0" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Padding="0,0,10,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- ==================== Appearance: applies immediately =================== -->
                <TextBlock Style="{StaticResource SectionHeading}" Text="Appearance" />
                <TextBlock Margin="0,0,0,8"
                           Style="{StaticResource HintText}"
                           Text="Applies immediately — no need to save." />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource RowLabel}" Text="Widget appearance" />
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              ItemsSource="{Binding WidgetAppearances}"
                              SelectedItem="{Binding WidgetAppearance}"
                              Style="{StaticResource RowCombo}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource RowLabel}" Text="Font" />
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              ItemsSource="{Binding WidgetFonts}"
                              SelectedItem="{Binding WidgetFont}"
                              Style="{StaticResource RowCombo}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource RowLabel}" Text="Text weight" />
                    <ComboBox Grid.Row="2" Grid.Column="1"
                              ItemsSource="{Binding WidgetTextWeights}"
                              SelectedItem="{Binding WidgetTextWeight}"
                              Style="{StaticResource RowCombo}" />
                </Grid>

                <CheckBox Content="Show RAM used / total GB"
                          IsChecked="{Binding ShowRamUsedAndTotal}"
                          Margin="0,10,0,0" />

                <CheckBox Content="Start with Windows"
                          IsChecked="{Binding StartWithWindows}"
                          Margin="0,8,0,0" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource HintText}"
                           Text="Automatically start the widget when you sign in, about 10 seconds after logon. This registers a scheduled task with administrator rights, so later sign-ins start the widget without a UAC prompt. It does not affect Defender or the driver blocking, so it will not restore CPU temperature on its own." />

                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource HintText}"
                           Text="Text size, opacity, always-on-top and lock are on the widget's right-click menu." />

                <Separator Margin="0,16,0,12" />

                <!-- ================== Colour stages: applies immediately ================== -->
                <TextBlock Style="{StaticResource SectionHeading}" Text="Colour stages" />
                <TextBlock Margin="0,0,0,6"
                           Style="{StaticResource HintText}"
                           Text="Applies immediately. Untick a metric to hide it from the widget, and drag the grip to reorder — the widget follows this order. Each metric is graded over its own scale rather than 0–100, because a CPU is never near 0 °C and fan RPM is not a percentage. Enter the upper bound of stages 1 to 4; stage 5 is everything above stage 4." />

                <StackPanel Margin="0,4,0,10" Orientation="Horizontal">
                    <Border Background="#2ECC71" CornerRadius="2" Height="12" Margin="0,0,4,0" Width="20" />
                    <Border Background="#9ACD32" CornerRadius="2" Height="12" Margin="0,0,4,0" Width="20" />
                    <Border Background="#FFD21E" CornerRadius="2" Height="12" Margin="0,0,4,0" Width="20" />
                    <Border Background="#FF9800" CornerRadius="2" Height="12" Margin="0,0,4,0" Width="20" />
                    <Border Background="#FF4D4F" CornerRadius="2" Height="12" Margin="0,0,8,0" Width="20" />
                    <TextBlock Style="{StaticResource HintText}"
                               Text="stage 1 (healthy) to stage 5 (critical)"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Margin="41,0,0,0" Style="{StaticResource StageHeader}"
                               Text="Show / metric" TextAlignment="Left" VerticalAlignment="Bottom" Width="Auto" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource StageHeader}" Text="1 ≤" />
                        <TextBlock Style="{StaticResource StageHeader}" Text="2 ≤" />
                        <TextBlock Style="{StaticResource StageHeader}" Text="3 ≤" />
                        <TextBlock Style="{StaticResource StageHeader}" Text="4 ≤" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource StageHeader}"
                               Text="Scale" TextAlignment="Left" VerticalAlignment="Bottom" Width="92" />
                </Grid>

                <!-- A ListBox rather than an ItemsControl so each row has a container to
                     hit-test during a drag. Dragging starts only from the grip, so it cannot
                     interfere with the checkbox or with typing in the threshold boxes. -->
                <ListBox AllowDrop="True"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ItemsSource="{Binding StageRows}"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="2,1" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="AllowDrop" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="3"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Stretch" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <EventSetter Event="DragOver" Handler="OnRowDragOver" />
                            <EventSetter Event="Drop" Handler="OnRowDrop" />
                            <Style.Triggers>
                                <!-- Makes the drag grip discoverable and gives the live reorder
                                     something to follow. -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFEDF1F5" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MetricStageRowViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Cursor="SizeAll"
                                           Foreground="{StaticResource DialogMutedTextBrush}"
                                           FontSize="13"
                                           Margin="0,0,8,0"
                                           PreviewMouseLeftButtonDown="OnDragGripPressed"
                                           Text="⋮⋮"
                                           ToolTip="Drag to reorder — this is the order the widget shows"
                                           VerticalAlignment="Center" />

                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding IsVisible}"
                                          Margin="0,0,8,0"
                                          ToolTip="Show this metric in the widget"
                                          VerticalAlignment="Center" />

                                <TextBlock Grid.Column="2" Style="{StaticResource RowLabel}" Text="{Binding Label}" />

                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <TextBox Style="{StaticResource StageBox}" Text="{Binding Stage1Maximum, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Style="{StaticResource StageBox}" Text="{Binding Stage2Maximum, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Style="{StaticResource StageBox}" Text="{Binding Stage3Maximum, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Style="{StaticResource StageBox}" Text="{Binding Stage4Maximum, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <TextBlock Grid.Column="4"
                                           Margin="8,0,0,0"
                                           Style="{StaticResource HintText}"
                                           Text="{Binding ScaleText}"
                                           VerticalAlignment="Center"
                                           Width="92" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Command="{Binding ResetStagesCommand}"
                        Content="Reset stages to defaults"
                        HorizontalAlignment="Left"
                        Margin="0,10,0,0" />

                <Separator Margin="0,16,0,12" />

                <!-- =========== Monitoring: pending until its own Save button below ========= -->
                <TextBlock Style="{StaticResource SectionHeading}" Text="Monitoring" />
                <TextBlock Margin="0,0,0,10"
                           Style="{StaticResource HintText}"
                           Text="These rebuild the polling schedule, so they take effect when you press Save." />

                <CheckBox Content="Collect history"
                          IsChecked="{Binding CollectHistory}"
                          Margin="0,0,0,6" />
                <CheckBox Content="Use same polling interval for all"
                          IsChecked="{Binding UseUnifiedPollingInterval}"
                          Margin="0,0,0,12" />

                <Grid Visibility="{Binding UseUnifiedPollingInterval, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="Polling interval" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding IntervalOptions}"
                              SelectedItem="{Binding UnifiedInterval}"
                              Style="{StaticResource IntervalCombo}" />
                </Grid>

                <!-- Hidden entirely while unified polling is on, so there is no ambiguity about
                     which values are in effect. -->
                <Grid Visibility="{Binding IndividualIntervalsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource RowLabel}" Text="CPU temperature" />
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding IntervalOptions}"
                              SelectedItem="{Binding CpuTemperatureInterval}" Style="{StaticResource IntervalCombo}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource RowLabel}" Text="CPU usage" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding IntervalOptions}"
                              SelectedItem="{Binding CpuUsageInterval}" Style="{StaticResource IntervalCombo}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource RowLabel}" Text="RAM usage" />
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding IntervalOptions}"
                              SelectedItem="{Binding MemoryUsageInterval}" Style="{StaticResource IntervalCombo}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource RowLabel}" Text="GPU temperature" />
                    <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding IntervalOptions}"
                              SelectedItem="{Binding GpuTemperatureInterval}" Style="{StaticResource IntervalCombo}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource RowLabel}" Text="GPU core usage" />
                    <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding IntervalOptions}"
                              SelectedItem="{Binding GpuComputeUsageInterval}" Style="{StaticResource IntervalCombo}" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource RowLabel}" Text="GPU memory usage" />
                    <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding IntervalOptions}"
                              SelectedItem="{Binding GpuMemoryUsageInterval}" Style="{StaticResource IntervalCombo}" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource RowLabel}" Text="VRAM temperature" />
                    <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding IntervalOptions}"
                              SelectedItem="{Binding GpuMemoryTemperatureInterval}" Style="{StaticResource IntervalCombo}" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource RowLabel}" Text="GPU fan" />
                    <ComboBox Grid.Row="7" Grid.Column="1" ItemsSource="{Binding IntervalOptions}"
                              SelectedItem="{Binding GpuFanInterval}" Style="{StaticResource IntervalCombo}" />
                </Grid>

                <Separator Margin="0,14,0,12" />

                <CheckBox Content="Poll more slowly when the computer is idle"
                          IsChecked="{Binding UseIdlePolling}"
                          Margin="0,0,0,8" />

                <Grid Visibility="{Binding UseIdlePolling, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="Consider idle after" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding IdleAfterOptions}"
                              SelectedItem="{Binding IdleAfter}"
                              Style="{StaticResource IntervalCombo}" />
                </Grid>

                <!-- Idle follows the same unified/individual mode as active polling, so exactly one
                     of these two blocks is ever visible. -->
                <Grid Visibility="{Binding IdleUnifiedVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="Idle polling interval" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding IdleIntervalOptions}"
                              SelectedItem="{Binding IdleUnifiedInterval}"
                              Style="{StaticResource IntervalCombo}" />
                </Grid>

                <StackPanel Visibility="{Binding IdleIndividualVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Margin="0,6,0,4"
                               Style="{StaticResource HintText}"
                               Text="Idle interval per metric" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource RowLabel}" Text="CPU temperature" />
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding IdleIntervalOptions}"
                                  SelectedItem="{Binding IdleCpuTemperatureInterval}" Style="{StaticResource IntervalCombo}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource RowLabel}" Text="CPU usage" />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding IdleIntervalOptions}"
                                  SelectedItem="{Binding IdleCpuUsageInterval}" Style="{StaticResource IntervalCombo}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource RowLabel}" Text="RAM usage" />
                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding IdleIntervalOptions}"
                                  SelectedItem="{Binding IdleMemoryUsageInterval}" Style="{StaticResource IntervalCombo}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource RowLabel}" Text="GPU temperature" />
                        <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding IdleIntervalOptions}"
                                  SelectedItem="{Binding IdleGpuTemperatureInterval}" Style="{StaticResource IntervalCombo}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource RowLabel}" Text="GPU core usage" />
                        <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding IdleIntervalOptions}"
                                  SelectedItem="{Binding IdleGpuComputeUsageInterval}" Style="{StaticResource IntervalCombo}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource RowLabel}" Text="GPU memory usage" />
                        <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding IdleIntervalOptions}"
                                  SelectedItem="{Binding IdleGpuMemoryUsageInterval}" Style="{StaticResource IntervalCombo}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource RowLabel}" Text="VRAM temperature" />
                        <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding IdleIntervalOptions}"
                                  SelectedItem="{Binding IdleGpuMemoryTemperatureInterval}" Style="{StaticResource IntervalCombo}" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource RowLabel}" Text="GPU fan" />
                        <ComboBox Grid.Row="7" Grid.Column="1" ItemsSource="{Binding IdleIntervalOptions}"
                                  SelectedItem="{Binding IdleGpuFanInterval}" Style="{StaticResource IntervalCombo}" />
                    </Grid>
                </StackPanel>

                <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                    <Button Command="{Binding SaveMonitoringCommand}"
                            Content="Save monitoring settings"
                            MinWidth="184"
                            Style="{StaticResource DialogPrimaryButton}" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                <Setter Property="Text" Value="Unsaved changes" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnsavedMonitoringChanges}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <TextBlock Foreground="{StaticResource DialogErrorBrush}"
                       Margin="0,0,0,6"
                       Text="{Binding ValidationMessage}"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ValidationMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Foreground="{StaticResource DialogSuccessBrush}"
                           Text="{Binding SavedMessage}"
                           VerticalAlignment="Center" />

                <Button Grid.Column="1"
                        Command="{Binding CloseCommand}"
                        Content="Close"
                        IsCancel="True"
                        MinWidth="88" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
